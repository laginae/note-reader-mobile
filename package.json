{
  "name": "note-reader-mobile",
  "version": "0.4.2",
  "private": true,
  "description": "Mobile-first note, PDF and local HTML voice reader with academic reading tools and WAV export.",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/main.js --bundle --external:obsidian --external:@codemirror/state --external:@codemirror/view --platform=browser --format=cjs --target=es2020 --outfile=main.js --log-level=warning",
    "test": "npm run build && node --test test/*.test.cjs && npm run check:mobile",
    "check:mobile": "node scripts/check-mobile-boundary.cjs",
    "benchmark:playback": "node scripts/benchmark-playback.cjs"
  },
  "dependencies": {
    "@laginae/note-reader-core": "github:laginae/note-reader-core#e2f9b110f85377cce59f6bb5727dc836e0f5fd4b",
    "htmlparser2": "10.0.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
